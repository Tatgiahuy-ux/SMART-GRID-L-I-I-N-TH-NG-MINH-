# Chuẩn hoá encoding cho editor (VS Code, JetBrains...).
# QUAN TRỌNG: file .ps1 phải là UTF-8 CÓ BOM, nếu không Windows PowerShell 5.1 sẽ đọc sai
# tiếng Việt và báo lỗi cú pháp (Unexpected token).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100
